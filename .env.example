# Copy to .env and adjust. Everything here has a safe default; the values below
# are what `docker compose up` uses out of the box.
#
# SECURITY: this app has no authentication layer. Run it on a private network
# (VPN, or a Cloudflare Tunnel with an Access policy). Never expose it directly
# to the open internet.

# --- Runtime ---
# DEMO_MODE=1 seeds an empty database with fictional notes and events and makes
# the write-through endpoints read-only. Set to 0 for a real deployment.
DEMO_MODE=1
# Host port the UI/API is published on.
AGORA_PORT=8080

# --- Storage (paths are inside the container) ---
AGORA_DB_PATH=/data/agora.db
UPLOAD_DIR=/data/uploads
FINANCE_DATA_DIR=/data/finance
CRON_JSON_PATH=/data/cron.json
CRON_SCRIPTS_DIR=/data/scripts
REACT_DIST=/app/frontend

# --- Security ---
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:8080
# The built-in code runner (POST /api/run-code) shells out to python3/node.
# It is disabled unless this is set to 1. It also only accepts requests from
# 127.0.0.1/::1, so keep it off in any container that other people can reach.
ENABLE_CODE_EXEC=0

# --- Optional integrations ---
# Read-only Google Calendar: paste the secret iCal address of the calendar you
# want to display. Leave empty to disable the Google calendar sync entirely.
GOOGLE_ICAL_URL=
# Base URL of a Hermes-compatible cron API, used by the "run now" button.
HERMES_API_URL=http://localhost:8080
